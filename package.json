{
  "name": "math-skills",
  "private": true,
  "version": "1.0.0",
  "description": "Fast, fun math and reading practice for kids",
  "type": "module",
  "scripts": {
    "predev": "node src/voice/tools/copy-ort.mjs",
    "dev": "vite",
    "prebuild": "node src/voice/tools/copy-ort.mjs",
    "build": "tsc -b && vite build",
    "preview:pages": "vite preview --base /math-skills/ --port 4183 --strictPort",
    "check:privacy": "node scripts/check-privacy.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "postinstall": "node src/voice/tools/copy-ort.mjs",
    "test:unit": "vitest run --dir src",
    "test:voice": "playwright test tests/voice.spec.ts --project=\"Desktop Chrome\"",
    "test:voice:latency": "playwright test tests/voice-latency.spec.ts --project=\"Desktop Chrome\" --workers=1"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react-speech-recognition": "^3.9.6",
    "canvas-confetti": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-simple-maps": "^3.0.0",
    "react-speech-recognition": "^4.0.1",
    "recharts": "^3.5.1",
    "regenerator-runtime": "^0.14.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-simple-maps": "^3.0.6",
    "@vitejs/plugin-basic-ssl": "1.2.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "playwright": "^1.57.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vitest": "2.1.9"
  },
  "license": "MIT"
}
